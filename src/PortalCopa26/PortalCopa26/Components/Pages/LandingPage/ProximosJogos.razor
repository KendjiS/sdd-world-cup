@using PortalCopa26.Models.Dtos

<section class="pc-section">
    <div class="pc-section-header">
        <h2 class="pc-section-title">Próximos Jogos</h2>
        <a href="jogos" class="btn btn-outline-portal btn-sm">Ver todos</a>
    </div>

    @if (Dias.Count == 0)
    {
        <p class="pc-empty">Nenhum jogo programado a partir da data de referência.</p>
    }
    else
    {
        @foreach (var dia in Dias)
        {
            <div class="pc-day-group">
                <JogosDataHeader Data="dia.Data" Quantidade="dia.Jogos.Count" />

                <div class="pc-game-list">
                    @foreach (var jogo in dia.Jogos)
                    {
                        <JogoCard @key="jogo.Numero" Jogo="jogo" Selo="Próximo" />
                    }
                </div>
            </div>
        }
    }
</section>

@code {
    /// <summary>Dias com jogos, em ordem cronológica; os horários já estão em Brasília.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<DiaJogosDto> Dias { get; set; } = [];
}
